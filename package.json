{
  "name": "@boomopen/workflow-kit",
  "version": "5.5.0",
  "description": "BoomOpen Workflow Kit v5.5 (Multi-Platform Unified & Smart-Hybrid Edition) - 100% unified orchestration across Antigravity, Claude Code, Codex, Cursor, and GitHub Copilot with 21 Specialist Agents, 17 Golden Triangle Teams, 1,450+ On-Demand Skills Vault, Pragmatic 2-Tier Coding Standards, Direct Plan-to-Executor Dispatch, Warm Sub-agent Reuse, and CLI doctor/check.",
  "main": "cli/install.js",
  "bin": {
    "boomopen": "./cli/install.js"
  },
  "scripts": {
    "install:cursor": "node cli/install.js install cursor",
    "install:copilot": "node cli/install.js install copilot",
    "install:antigravity": "node cli/install.js install antigravity",
    "install:claude": "node cli/install.js install claude",
    "install:codex": "node cli/install.js install codex",
    "install:all": "node cli/install.js install --all",
    "uninstall:cursor": "node cli/install.js uninstall cursor",
    "uninstall:copilot": "node cli/install.js uninstall copilot",
    "uninstall:antigravity": "node cli/install.js uninstall antigravity",
    "uninstall:claude": "node cli/install.js uninstall claude",
    "uninstall:codex": "node cli/install.js uninstall codex",
    "uninstall:all": "node cli/install.js uninstall --all",
    "list": "node cli/install.js list",
    "settings": "node cli/install.js settings",
    "settings:ui": "node cli/install.js settings --ui",
    "doctor": "node cli/install.js doctor",
    "check": "node cli/install.js check",
    "test": "node --test cli/install.test.js",
    "lint": "node --check cli/install.js && node --check cli/doctor.js && node --check cli/checker.js && node --check cli/settings.js && node --check cli/settings-ui.js && echo '✅ JavaScript syntax valid'",
    "lint:md": "echo 'Run: npx markdownlint \"**/*.md\" --ignore node_modules' to lint Markdown",
    "semantic-release": "semantic-release",
    "prepare": "husky install || true"
  },
  "keywords": [
    "agentic-coding",
    "ai-agents",
    "cursor",
    "copilot",
    "antigravity",
    "gemini",
    "claude",
    "codex",
    "cli",
    "automation",
    "agent-orchestration",
    "multi-agent"
  ],
  "author": "Kennyboom",
  "license": "MIT",
  "files": [
    "cli/",
    "agents/",
    "commands/",
    "rules/",
    "matrix-skills/",
    "skills/",
    "documents/",
    "i18n/",
    "platforms/",
    "AGENT.md",
    "CLAUDE.md",
    "CODEX.md",
    "COPILOT.md",
    "CURSOR.md",
    "GEMINI.md",
    "LICENSE",
    "README.md",
    "SKILL.md",
    "CHANGELOG.md"
  ],
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^11.1.0",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^9.2.6",
    "@semantic-release/npm": "^11.0.2",
    "@semantic-release/release-notes-generator": "^12.1.0",
    "conventional-changelog-conventionalcommits": "^7.0.2",
    "husky": "^8.0.3",
    "semantic-release": "^22.0.12"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Kennyboom/BoomOpen-Workflow-Kit.git"
  },
  "homepage": "https://github.com/Kennyboom/BoomOpen-Workflow-Kit#readme",
  "bugs": {
    "url": "https://github.com/Kennyboom/BoomOpen-Workflow-Kit/issues"
  }
}
